{
  "name": "ai-agent-cli",
  "version": "1.0.0",
  "type": "module",
  "description": "A TypeScript CLI AI agent built from scratch to explore agent loops, tool calling, context management, code execution, and human-in-the-loop workflows.",
  "main": "index.js",
  "bin": {
    "agi": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "eval": "npx lmnr eval"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Usman-Ubaid/ai-agent-cli.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Usman-Ubaid/ai-agent-cli/issues"
  },
  "homepage": "https://github.com/Usman-Ubaid/ai-agent-cli#readme",
  "dependencies": {
    "@ai-sdk/openai": "^4.0.83",
    "@lmnr-ai/lmnr": "^0.8.49",
    "ai": "^7.0.127",
    "dotenv": "^18.0.5",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "react": "^19.3.0",
    "shelljs": "^0.10.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/shelljs": "^0.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
